{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/reports",
      "!**/.stryker-tmp",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended", "next": "recommended" },
    "rules": {
      "preset": "recommended",
      "suspicious": { "noArrayIndexKey": "error" },
      "style": { "useImportType": "error", "noNonNullAssertion": "error" },
      "a11y": { "useButtonType": "error", "useAltText": "error", "useValidAnchor": "error" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
